SUNJUDGE_ENV=development
SECRET_KEY=dev-only-change-me
# Omit DATABASE_URL to use backend/instance/sunjudge.sqlite.
# Optional local encryption key; keep it stable after saving teacher API keys.
# LLM_ENCRYPTION_KEY=
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# Configure both SMTP_HOST and SMTP_FROM to enable email recovery.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURITY=starttls
# SMTP_FROM=judge@example.com
# SMTP_USERNAME=judge@example.com
# SMTP_PASSWORD=

